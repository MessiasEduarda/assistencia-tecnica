generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  plan      Plan     @default(BASIC)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  clients       Client[]
  equipment     Equipment[]
  serviceOrders ServiceOrder[]
  parts         Part[]
  suppliers     Supplier[]
  transactions  Transaction[]
  auditLogs     AuditLog[]
}

enum Plan {
  BASIC
  PRO
  ENTERPRISE
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String
  password  String
  role      Role     @default(ATTENDANT)
  active    Boolean  @default(true)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]  @relation("TechnicianOrders")
  statusChanges StatusHistory[]
  auditLogs     AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum Role {
  ADMIN
  ATTENDANT
  TECHNICIAN
}

model Client {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  document     String?
  phone        String
  whatsapp     String?
  email        String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zip          String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipment Equipment[]
  orders    ServiceOrder[]

  @@index([tenantId])
}

model Equipment {
  id           String   @id @default(uuid())
  tenantId     String
  clientId     String
  type         String
  brand        String
  model        String
  serialNumber String?
  imei         String?
  accessories  String[]
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orders ServiceOrder[]

  @@index([tenantId])
  @@index([clientId])
}

model ServiceOrder {
  id             String    @id @default(uuid())
  number         String
  tenantId       String
  clientId       String
  equipmentId    String
  technicianId   String?
  status         OSStatus  @default(RECEIVED)
  priority       Priority  @default(NORMAL)
  entryDate      DateTime  @default(now())
  slaDeadline    DateTime?
  reportedDefect String
  diagnosis      String?
  testsPerformed String?
  budgetParts    Decimal   @default(0) @db.Decimal(10, 2)
  budgetLabor    Decimal   @default(0) @db.Decimal(10, 2)
  budgetTotal    Decimal   @default(0) @db.Decimal(10, 2)
  clientApproved Boolean?
  approvalDate   DateTime?
  publicToken    String    @unique @default(uuid())
  warranty       Int?
  rating         Int?
  feedback       String?
  internalNotes  String?
  completedAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client        Client          @relation(fields: [clientId], references: [id])
  equipment     Equipment       @relation(fields: [equipmentId], references: [id])
  technician    User?           @relation("TechnicianOrders", fields: [technicianId], references: [id])
  statusHistory StatusHistory[]
  attachments   Attachment[]
  partsUsed     OrderPart[]
  transactions  Transaction[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([publicToken])
}

enum OSStatus {
  RECEIVED
  ANALYSIS
  WAITING_APPROVAL
  IN_REPAIR
  DONE
  DELIVERED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model StatusHistory {
  id          String    @id @default(uuid())
  orderId     String
  fromStatus  OSStatus?
  toStatus    OSStatus
  changedById String
  note        String?
  createdAt   DateTime  @default(now())

  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User         @relation(fields: [changedById], references: [id])

  @@index([orderId])
}

model Part {
  id          String   @id @default(uuid())
  tenantId    String
  supplierId  String?
  name        String
  sku         String
  description String?
  quantity    Int      @default(0)
  minQuantity Int      @default(0)
  cost        Decimal  @default(0) @db.Decimal(10, 2)
  salePrice   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier   Supplier?       @relation(fields: [supplierId], references: [id])
  movements  StockMovement[]
  orderParts OrderPart[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model StockMovement {
  id        String       @id @default(uuid())
  partId    String
  type      MovementType
  quantity  Int
  reason    String?
  createdBy String
  createdAt DateTime     @default(now())

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
}

enum MovementType {
  IN
  OUT
}

model OrderPart {
  id       String  @id @default(uuid())
  orderId  String
  partId   String
  quantity Int
  unitCost Decimal @db.Decimal(10, 2)

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  part  Part         @relation(fields: [partId], references: [id])

  @@unique([orderId, partId])
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  contact   String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parts        Part[]
  transactions Transaction[]

  @@index([tenantId])
}

model Transaction {
  id            String          @id @default(uuid())
  tenantId      String
  orderId       String?
  supplierId    String?
  type          TransactionType
  description   String
  amount        Decimal         @db.Decimal(10, 2)
  paymentMethod PaymentMethod?
  dueDate       DateTime
  paidDate      DateTime?
  paid          Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    ServiceOrder? @relation(fields: [orderId], references: [id])
  supplier Supplier?     @relation(fields: [supplierId], references: [id])

  @@index([tenantId])
  @@index([tenantId, type])
}

enum TransactionType {
  RECEIVABLE
  PAYABLE
}

enum PaymentMethod {
  CASH
  CARD
  PIX
  INSTALLMENT
  BANK_SLIP
}

model Attachment {
  id        String   @id @default(uuid())
  orderId   String
  type      String
  url       String
  label     String?
  createdAt DateTime @default(now())

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entity, entityId])
}